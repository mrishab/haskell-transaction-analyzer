.cabal-sandbox/
cabal.sandbox.config

# Stack
.stack-work/
stack.yaml.lock

# GHCi files
.ghci

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Haskell Language Server
.hie/
hie.yaml

# Profiling and coverage
*.prof
*.hp
*.eventlog
.hpc/

# Documentation
.haddock/
docs/

# Temporary files
*.tmp
*.temp

# Logs
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# GHCJS
.ghcjs/
